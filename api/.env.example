ENV=development
JWT_SECRET=
DATABASE_URL=sqlite:///./haanji.db
CORS_ORIGINS=http://localhost:5173
GNANI_API_KEY=
TWOFACTOR_API_KEY=
# Reasoning model (OpenAI-compatible). Evon on vLLM: LLM_BASE_URL=https://<gpu-host>/v1 LLM_MODEL=model
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=model
# Or Claude Haiku 5.5 (used when LLM_BASE_URL is empty)
ANTHROPIC_API_KEY=
# Number calls are forwarded to (set once telephony is connected)
HAANJI_NUMBER=
# Exotel Voicebot stream auth (Basic auth password in the applet URL)
PHONE_STREAM_SECRET=
